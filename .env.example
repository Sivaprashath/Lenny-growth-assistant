# ══════════════════════════════════════════════════════════════════
# Lenny Growth Assistant — Environment Configuration
# ══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── LLM Provider ─────────────────────────────────────────────────
# Options: ollama (default, local), anthropic, openai
# Change this one variable to switch providers — no code changes needed.
LLM_PROVIDER=ollama

# ── Ollama (Local LLM — required for demo) ───────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# Other good models: mistral:7b, phi3:mini, gemma2:2b
OLLAMA_TIMEOUT=120

# ── Anthropic Claude (Cloud) ─────────────────────────────────────
# Required only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# ── OpenAI (Cloud) ───────────────────────────────────────────────
# Required only if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Database (PostgreSQL) ─────────────────────────────────────────
# Docker Compose sets this automatically.
# For Supabase: postgresql+asyncpg://postgres:[password]@db.[project].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_assistant

# ── Supabase (Optional — for cloud DB) ───────────────────────────
SUPABASE_URL=
SUPABASE_KEY=

# ── App Settings ─────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000

# ── Security ─────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# ── Knowledge Base ────────────────────────────────────────────────
TRANSCRIPTS_DIR=./data/transcripts
CHROMA_PERSIST_DIR=./data/chroma
TOP_K_RETRIEVAL=5
